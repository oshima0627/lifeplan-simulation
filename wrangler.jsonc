// Cloudflare Workers (Static Assets) の設定
// デプロイ: npm run deploy（要 `wrangler login` または CLOUDFLARE_API_TOKEN）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeplan-simulator",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  // stripe SDK（サブプロジェクトB）で必要になる。先に入れておく
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    // Worker から静的アセットを返すために必要
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // ⚠️ これが無いと /api/* へのナビゲーションリクエストが 404.html になる。
    // true にすると静的アセットの配信まで Worker の実行回数に計上されるため、
    // 配列で /api/* だけに絞る
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeplan",
      "database_id": "15dfcc4a-14f4-487b-b22d-bdf189c062d9",
      "migrations_dir": "d1/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "9dd830bf032343e6a9513a1fd5ed4a28" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [
    {
      "tag": "v1",
      // ⚠️ 無料枠では SQLite バックエンドが必須。new_classes ではない
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // 公開値なのでシークレットにしない。RESEND_API_KEY は絶対にここへ置かない
    "MAIL_FROM": "ライフプランシミュレーター <noreply@nexeed-lab.com>",
    // パスワード再設定メールのリンク組み立てに使う正規オリジン。
    // Request.url から導出しない理由は worker/env.ts の AppEnv["APP_URL"] コメント参照
    "APP_URL": "https://lifeplan.nexeed-lab.com"
  },
  // `routes` が1件あれば wrangler は workers_dev を暗黙に無効化するが、
  // その暗黙の挙動に安全性（再設定リンクのオリジンがぶれないこと）を
  // 依存させないよう明示する。設定変更で静かに壊れないようにするため
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "lifeplan.nexeed-lab.com",
      "custom_domain": true
    }
  ]
}
